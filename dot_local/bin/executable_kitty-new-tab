#!/usr/bin/python3
"""Open a directory in an existing Kitty tab, or start Kitty if none is reachable."""
import json
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import unquote, urlsplit


def directory(argument):
    if argument.startswith("file:"):
        url = urlsplit(argument)
        if url.netloc not in ("", "localhost"):
            raise ValueError("Only local file URLs are supported")
        argument = unquote(url.path)
    path = Path(argument).expanduser().resolve()
    if not path.is_dir():
        raise ValueError(f"Not a directory: {path}")
    return str(path)


def compositor_windows():
    try:
        result = subprocess.run(
            ["niri", "msg", "--json", "windows"], capture_output=True,
            text=True, check=True, timeout=2,
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def main():
    try:
        cwd = directory(sys.argv[1] if len(sys.argv) > 1 else str(Path.home()))
    except ValueError as error:
        print(error, file=sys.stderr)
        return 1

    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    windows = compositor_windows()
    kitty_windows = [w for w in windows if w.get("app_id") == "kitty"]

    def recent_use(socket):
        try:
            pid = int(socket.name.rsplit("-", 1)[1])
        except ValueError:
            return (0, 0)
        times = [w.get("focus_timestamp") or {} for w in kitty_windows if w.get("pid") == pid]
        return max(((t.get("secs", 0), t.get("nanos", 0)) for t in times), default=(0, 0))

    for socket in sorted(runtime.glob("kitty-vicinae-*"), key=recent_use, reverse=True):
        if not socket.is_socket():
            continue
        try:
            result = subprocess.run(
                ["kitten", "@", "--to", f"unix:{socket}", "launch", "--type=tab", "--cwd", cwd],
                capture_output=True, text=True, timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        if result.returncode != 0:
            continue
        # Wayland clients cannot reliably focus themselves; ask Niri explicitly.
        try:
            pid = int(socket.name.rsplit("-", 1)[1])
            matches = [w for w in kitty_windows if w.get("pid") == pid]
            matches.sort(key=lambda w: ((w.get("focus_timestamp") or {}).get("secs", 0),
                                        (w.get("focus_timestamp") or {}).get("nanos", 0)), reverse=True)
            if matches:
                subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(matches[0]["id"])],
                               capture_output=True, timeout=2)
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
        return 0

    os.execvp("kitty", ["kitty", "--single-instance", "--working-directory", cwd])


if __name__ == "__main__":
    sys.exit(main())
