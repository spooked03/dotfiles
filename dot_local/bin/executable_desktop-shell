#!/usr/bin/env bash
# Session-only switch: Noctalia remains the default for the next login.
set -euo pipefail
exec 9>"${XDG_RUNTIME_DIR:?}/desktop-shell-switch.lock"
flock 9
case "${1:-}" in
    noctalia)
        command -v noctalia >/dev/null
        systemctl --user stop dms.service
        if systemctl --user start noctalia-trial.service; then
            for ((i=0; i<50; i++)); do
                if noctalia msg status >/dev/null 2>&1; then
                    echo 'Noctalia is running. Return to DMS: desktop-shell dms'
                    exit 0
                fi
                sleep 0.2
            done
        fi
        systemctl --user stop noctalia-trial.service
        systemctl --user start dms.service
        echo 'Noctalia did not start; DMS has been restored. See: journalctl --user -u noctalia-trial' >&2
        exit 1
        ;;
    dms)
        systemctl --user stop noctalia-trial.service
        systemctl --user start dms.service
        echo 'DMS is running.'
        ;;
    *)
        echo 'Usage: desktop-shell {noctalia|dms}' >&2
        exit 2
        ;;
esac
