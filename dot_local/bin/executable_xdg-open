#!/bin/bash
# Pi's ordinary mouse clicks use xdg-open, bypassing Kitty open-actions.conf.
# Normalize local Markdown/solution links through the shared file opener.
if [[ $# == 1 ]]; then
    target_lower=${1,,}
    if [[ ! $target_lower =~ ^[a-z][a-z0-9+.-]*:// || $target_lower == file://* ]]; then
        if [[ $target_lower =~ \.(md|markdown|mkd|sln|slnx)(:[0-9]+(:[0-9]+)?)?([?#].*)?$ ]]; then
            exec "$HOME/.local/bin/open-local-link-from-kitty" "$1"
        fi
    fi
fi
exec /usr/bin/xdg-open "$@"
