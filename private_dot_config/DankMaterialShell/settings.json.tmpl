{
  "customThemeFile": {{ printf "%s/.config/DankMaterialShell/themes/gruvboxMaterial/theme.json" .chezmoi.homeDir | toJson }},
  "registryThemeVariants": {
    "gruvboxMaterial": "hard"
  },
  "cornerRadius": 12,
  "niriLayoutBorderSize": 1,
  "clockFormat": "12h",
  "customAnimationDuration": 1000,
  "syncComponentAnimationSpeeds": false,
  "barElevationEnabled": false,
  "runningAppsCurrentWorkspace": false,
  "useAutoLocation": true,
  "networkPreference": "wifi",
  "cursorSettings": {
    "theme": "System Default",
    "size": 24,
    "niri": {
      "hideWhenTyping": false,
      "hideAfterInactiveMs": 0
    },
    "hyprland": {
      "hideOnKeyPress": false,
      "hideOnTouch": false,
      "inactiveTimeout": 0
    },
    "dwl": {
      "cursorHideTimeout": 0
    }
  },
  "acMonitorTimeout": 60,
  "acLockTimeout": 60,
  "acSuspendTimeout": 1800,
  "acPostLockMonitorTimeout": 15,
  "batteryMonitorTimeout": 60,
  "batteryLockTimeout": 60,
  "batterySuspendTimeout": 1800,
  "batteryPostLockMonitorTimeout": 15,
{{ if eq (get . "deviceRole") "laptop" }}  "batteryChargeLimit": 80,
{{ end }}  "lockBeforeSuspend": true,
  "matugenTemplateKitty": false,
  "dockSpacing": 8,
  "enableFprint": true,
  "maxFprintTries": 3,
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": true,
      "position": 0,
      "screenPreferences": [
        "all"
      ],
      "showOnLastDisplay": true,
      "leftWidgets": [
        "launcherButton",
        "workspaceSwitcher",
        "focusedWindow"
      ],
      "centerWidgets": [
        "music",
        "clock",
        "weather"
      ],
      "rightWidgets": [
        "systemTray",
        "clipboard",
        "cpuUsage",
        "memUsage",
        "notificationButton",
        "battery",
        "controlCenterButton"
      ],
      "spacing": 2,
      "innerPadding": -2,
      "bottomGap": -1,
      "transparency": 1,
      "widgetTransparency": 1,
      "squareCorners": false,
      "noBackground": false,
      "gothCornersEnabled": false,
      "gothCornerRadiusOverride": false,
      "gothCornerRadiusValue": 12,
      "borderEnabled": false,
      "borderColor": "surfaceText",
      "borderOpacity": 1,
      "borderThickness": 1,
      "fontScale": 1,
      "autoHide": false,
      "autoHideDelay": 250,
      "openOnOverview": false,
      "visible": true,
      "popupGapsAuto": true,
      "popupGapsManual": 4,
      "clickThrough": false,
      "showOnWindowsOpen": true,
      "maximizeWidgetIcons": false,
      "removeWidgetPadding": false,
      "widgetOutlineEnabled": false,
      "shadowIntensity": 0,
      "widgetPadding": 8,
      "attachToScreenEdge": false,
      "useOverlayLayer": false,
      "hoverPopouts": false,
      "maximizeDetection": true
    }
  ],
  "desktopClockCustomColor": {
    "r": 1,
    "g": 1,
    "b": 1,
    "a": 1,
    "hsvHue": -1,
    "hsvSaturation": 0,
    "hsvValue": 1,
    "hslHue": -1,
    "hslSaturation": 0,
    "hslLightness": 1,
    "valid": true,
    "rgba": -1
  },
  "systemMonitorCustomColor": {
    "r": 1,
    "g": 1,
    "b": 1,
    "a": 1,
    "hsvHue": -1,
    "hsvSaturation": 0,
    "hsvValue": 1,
    "hslHue": -1,
    "hslSaturation": 0,
    "hslLightness": 1,
    "valid": true,
    "rgba": -1
  },
  "builtInPluginSettings": {
    "dms_settings_search": {
      "trigger": "?"
    }
  },
  "configVersion": 18
}