// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "dms-charcoal-lavender"
      }
   },
   "launcher_window": {
      "opacity": 1,
      "size": {
         "width": 820,
         "height": 576
      },
      "compact_mode": {
         "enabled": false
      },
      "material": "none"
   },
   "favorites": [],
   "fallbacks": [
      "@selfxplanatorium/store.vicinae.fff-search:search-files",
      "@selfxplanatorium/store.vicinae.fff-search:search-file-contents",
      "files:search"
   ],
   "providers": {
      "@AdityaZxxx/store.vicinae.helium": {
         "preferences": {
            "profile_dir": ".config/net.imput.helium"
         },
         "entrypoints": {
            "open-new-tab": {
               "enabled": false
            },
            "open-new-window": {
               "enabled": false
            },
            "open-private-window": {
               "enabled": false
            },
            "search-bookmarks": {
               "enabled": false
            },
            "search-web": {
               "enabled": false
            }
         }
      },
      "@FurkanTRN/store.vicinae.jetbrains-recent-projects": {
         "preferences": {
            "toolboxAppsDirInput": "",
            "toolboxScriptsDirInput": ""
         }
      },
      "@c4n4m1/store.vicinae.zoxide-recent-directories": {
         "preferences": {
            "application": "kitty.desktop",
            "defaultFilter": "all"
         }
      },
      "@luolei/store.raycast.karakeep": {
{{ if eq (get . "deviceRole") "laptop" }}         "enabled": false
{{ else }}         "preferences": {
            "language": "en",
            "apiUrl": {{ .karakeepUrl | toJson }},
            "prefillUrlFromBrowser": false,
            "showWebsitePreview": true,
            "displayBookmarkPreview": false,
            "displayTags": true,
            "displayCreatedAt": true,
            "displayDescription": true,
            "displayNote": false,
            "displayBookmarkStatus": false,
            "displaySummary": true,
            "verboseLogging": false,
            "linkMainAction": "openInBrowser"
         },
         "entrypoints": {
            "backups": {
               "enabled": false
            },
            "bookmarks": {
               "enabled": true
            },
            "createBookmark": {
               "enabled": false
            },
            "createList": {
               "enabled": false
            },
            "createNote": {
               "enabled": false
            },
            "highlights": {
               "enabled": false
            },
            "lists": {
               "enabled": false
            },
            "notes": {
               "enabled": false
            },
            "quickBookmark": {
               "enabled": false
            },
            "stats": {
               "enabled": false
            },
            "tags": {
               "enabled": false
            },
            "updateKarakeep": {
               "enabled": false
            }
         }
{{ end }}      },
      "applications": {
         "preferences": {
            "defaultAction": "launch",
            "launchPrefix": "",
            "paths": []
         },
         "entrypoints": {
            "dev.zed.Zed": {
               "enabled": true
            }
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "clipboard": {
         "enabled": false,
         "preferences": {
            "monitoring": false
         }
      },
      "core": {
         "entrypoints": {
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "preferences": {
            "autoIndexing": true,
            "indexingPaths": [
               {{ .chezmoi.homeDir | toJson }}
            ],
            "excludedIndexingPaths": []
         }
      },
      "media": {
         "entrypoints": {
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "wm": {
         "enabled": false
      }
   }
}