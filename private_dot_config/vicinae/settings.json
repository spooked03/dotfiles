{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "dms-charcoal-lavender"
      }
   },
   "launcher_window": {
      "opacity": 1,
      "size": {
         "width": 820,
         "height": 576
      },
      "compact_mode": {
         "enabled": false
      },
      "material": "none"
   },
   "favorites": [],
   "providers": {
      "@AdityaZxxx/store.vicinae.helium": {
         "preferences": {
            "profile_dir": ".config/net.imput.helium"
         }
      },
      "@FurkanTRN/store.vicinae.jetbrains-recent-projects": {
         "preferences": {
            "toolboxAppsDirInput": "",
            "toolboxScriptsDirInput": ""
         }
      },
      "@c4n4m1/store.vicinae.zoxide-recent-directories": {
         "preferences": {
            "application": "kitty.desktop",
            "defaultFilter": "all"
         }
      },
      "applications": {
         "preferences": {
            "defaultAction": "launch",
            "launchPrefix": "",
            "paths": []
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "clipboard": {
         "enabled": false,
         "preferences": {
            "monitoring": false
         }
      },
      "core": {
         "entrypoints": {
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "preferences": {
            "autoIndexing": true,
            "indexingPaths": [
               "/home/nessie"
            ],
            "excludedIndexingPaths": []
         }
      },
      "media": {
         "entrypoints": {
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "snippets": {
         "preferences": {
            "enabled": true,
            "undo": true,
            "layout": "",
            "prePasteDelay": "0",
            "keyDelay": "2"
         }
      },
      "wm": {
         "enabled": false
      }
   }
}