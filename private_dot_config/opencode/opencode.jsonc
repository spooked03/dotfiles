{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "exa-parallel"
  },
  "permissions": [
    { "action": "super-productivity_*", "resource": "*", "effect": "ask" },
    { "action": "super-productivity_delete_task", "resource": "*", "effect": "deny" },
    { "action": "super-productivity_delete_habit", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "drawio": {
      "type": "local",
      "command": ["npx", "@next-ai-drawio/mcp-server@latest"],
      "enabled": false
    },
    "blender-mcp": {
      "type": "local",
      "command": ["/usr/bin/uvx", "blender-mcp"],
      "enabled": false,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    },
    "servers": {
      "super-productivity": {
        "type": "local",
        "command": [
          "/usr/bin/node",
          "/home/sietse/.local/share/opencode/mcp/super-productivity/node_modules/super-productivity-mcp/dist/index.js"
        ]
      }
    }
  }
}
