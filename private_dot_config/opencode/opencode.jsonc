{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "exa-parallel"
  },
  "mcp": {
    "drawio": {
      "type": "local",
      "command": ["npx", "@next-ai-drawio/mcp-server@latest"],
      "enabled": false
    },
    "blender-mcp": {
      "type": "local",
      "command": ["/usr/bin/uvx", "blender-mcp"],
      "enabled": false,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    }
  }
}
